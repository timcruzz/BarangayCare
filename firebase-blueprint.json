{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a patient, doctor, or barangay admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor", "admin"] },
        "photoURL": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "specialization": { "type": "string" },
        "barangayId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "Represents a telehealth session between a patient and a doctor.",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "completed", "cancelled"] },
        "symptoms": { "type": "string" },
        "notes": { "type": "string" },
        "prescription": { "type": "string" },
        "rating": { "type": "number" },
        "feedback": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "status", "createdAt"]
    },
    "Medicine": {
      "title": "Medicine",
      "description": "Represents medicine stock in a barangay.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "quantity": { "type": "integer" },
        "unit": { "type": "string" },
        "barangayId": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "quantity", "barangayId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "/consultations/{consultationId}": {
      "schema": "Consultation",
      "description": "Consultation records."
    },
    "/inventory/{medicineId}": {
      "schema": "Medicine",
      "description": "Medicine stock levels per barangay."
    }
  }
}
