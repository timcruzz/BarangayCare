rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Role Helpers (Expensive get() calls)
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : null;
    }
    function isDoctor() {
      return isSignedIn() && getUserData() != null && getUserData().role == 'doctor';
    }
    function isAdmin() {
      return isSignedIn() && getUserData() != null && getUserData().role == 'admin';
    }

    // User Profile Rules
    function isValidUser(data) {
      return data.uid is string && 
             data.email is string && 
             data.role in ['patient', 'doctor', 'admin'] &&
             data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(userId) || userId.size() >= 5 && userId[0:5] == "demo_");
      allow update: if isOwner(userId) || isAdmin();
    }

    // Consultation Rules
    function isValidConsultation(data) {
      return data.patientId is string && 
             data.status in ['pending', 'accepted', 'completed', 'cancelled'] &&
             data.createdAt != null;
    }

    match /consultations/{consultationId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Inventory Rules
    match /inventory/{medicineId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Relaxed for demo seeding
    }
  }
}
